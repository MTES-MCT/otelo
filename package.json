{
  "name": "otelo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "scalingo-prebuild": "corepack enable",
    "build": "pnpm --filter @otelo/shared build && pnpm --filter ${BUILD_TARGET} build",
    "build:shared": "pnpm --filter @otelo/shared build",
    "build:api": "pnpm --filter @otelo/api build",
    "build:web": "pnpm --filter @otelo/web build",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "clean": "rm -rf apps/*/node_modules apps/*/.next apps/*/dist packages/*/node_modules packages/*/dist node_modules",
    "scalingo-postbuild": "node scripts/scalingo-postbuild.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
