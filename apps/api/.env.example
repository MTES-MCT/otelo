DATABASE_URL=xxx

# Secret de signature des sessions better-auth. Obligatoire.
BETTER_AUTH_SECRET=xxx
# Adresse publique de l'API. Facultatif : sans valeur, better-auth la déduit de la requête.
BETTER_AUTH_URL=

# Secret de chiffrement des clés d'API des consommateurs externes. Obligatoire.
API_KEY_ENCRYPTION_SECRET=xxx

# Scalingo API Configuration (for CLI backup import)
SCALINGO_API_TOKEN=xxx
SCALINGO_APP_NAME=xxx
SCALINGO_ADDON_ID=xxx
SCALINGO_DB_API_URL=xxx
SCALINGO_REGION=xxx

PORT=xxx
NODE_ENV=xxx

BREVO_API_KEY=xxx
BREVO_API_URL=xxx
EMAIL_SENDER_NAME=xxx
EMAIL_SENDER_EMAIL=xxx
EMAIL_RECEIVER_EMAIL=xxx
# Set to "true" to actually send emails when NODE_ENV !== production. Default: skipped.
EMAIL_ENABLED=false

DEMARCHES_SIMPLIFIEES_TOKEN=xxxx
DEMARCHES_SIMPLIFIEES_URL=xxx
DEMARCHES_SIMPLIFIEES_DEMARCHE_ID=xxx

CLIENT_BASE_URL=xxx

BREVO_EMAIL_VERIFICATION_TEMPLATE_ID=xxx
BREVO_PASSWORD_RESET_TEMPLATE_ID=xxx
BREVO_IMPORT_USER_TEMPLATE_ID=xxx
BREVO_TWO_FACTOR_TEMPLATE_ID=xxx

OAUTH_PROCONNECT_CLIENT_ID=xxx
OAUTH_PROCONNECT_CLIENT_SECRET=xxx
OAUTH_PROCONNECT_ISSUER=xxx

# Intermédiaires réseau autorisés à annoncer l'adresse du visiteur, séparés par des
# virgules (adresse seule ou notation CIDR). Facultatif : sans valeur, les adresses de
# sortie de la plateforme en région osc-fr1 s'appliquent.
# Pour les relever : dig egress.osc-fr1.scalingo.com
# Vérification après changement : les clés de la table `rate_limits` doivent porter de
# vraies adresses, jamais « no-trusted-ip ».
TRUSTED_PROXY_IPS=171.33.105.206/32,171.33.92.211/32

# Comptes dispensés de la double authentification, séparés par des virgules.
# Adresse exacte (demo@otelo.test) ou domaine entier (@e2e.otelo.test).
# Le mot de passe et le contrôle d'accès restent exigés : seule la seconde étape saute.
# N'y mettre que des domaines dont vous maîtrisez la création, idéalement non routables.
# Laisser vide en production. Les entrées actives sont journalisées au démarrage.
TWO_FACTOR_BYPASS_EMAILS=

# Chemin du navigateur utilisé pour le rendu des graphiques de l'export PowerPoint.
# Facultatif : sans valeur, puppeteer utilise le navigateur qu'il a lui-même installé.
PUPPETEER_EXECUTABLE_PATH=
