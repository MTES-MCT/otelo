{
  "name": "@otelo/api",
  "version": "1.0.0",
  "description": "Backend for the Otelo Startup",
  "author": "KGALLET",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "build": "nest build",
    "postbuild": "[ \"$SYNC_DOCURBA_ON_BUILD\" = \"true\" ] && pnpm cli sync-docurba || true",
    "dev": "NODE_ENV=development pnpm cli sync-docurba && NODE_ENV=development nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start": "node dist/main",
    "start:dev": "NODE_ENV=development pnpm cli sync-docurba && NODE_ENV=development nest start --watch --exec \"node -r tsconfig-paths/register\"",
    "start:debug": "nest start --debug --watch --exec \"node -r tsconfig-paths/register\"",
    "start:prod": "node dist/main",
    "cli": "ts-node -r tsconfig-paths/register --project tsconfig.cli.json src/cli/cli.ts",
    "lint": "biome check src",
    "lint:format": "biome check src --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "postinstall": "[ \"$BUILD_TARGET\" = \"@otelo/api\" ] && prisma generate && npx puppeteer browsers install chrome-headless-shell || true",
    "prisma": "prisma",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@golevelup/ts-jest": "^0.7.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@otelo/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "@types/papaparse": "^5.5.2",
    "argon2": "^0.45.1",
    "axios": "^1.21.0",
    "better-auth": "~1.7.16",
    "chart.js": "^4.6.1",
    "commander": "^15.0.0",
    "dayjs": "catalog:",
    "dotenv": "^18.0.9",
    "escape-html": "^1.0.3",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jose": "6.2.13",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.0",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/commander": "^2.12.5",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^5.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
