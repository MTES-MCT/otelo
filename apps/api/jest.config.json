{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./",
  "testRegex": ".*\\.spec\\.ts$",
  "moduleNameMapper": {
    "^@test/(.*)$": "<rootDir>/test/$1",
    "^~/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(better-auth|better-call|@thallesp|\\.pnpm/(better-auth|better-call|@thallesp)))"],
  "collectCoverageFrom": ["src/**/*.(t|j)s"],
  "coveragePathIgnorePatterns": [
    "src/main.module.ts",
    "src/main.ts",
    "src/schemas/*",
    "src/db/prisma.service.ts",
    "src/common/decorators/*",
    ".module.ts",
    ".decorator.ts",
    ".config.ts"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "clearMocks": true
}
