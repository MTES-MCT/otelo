{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "types": ["node", "multer"],
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"],
  "include": ["src/**/*"]
}
