      "post": {
        "operationId": "SimulationsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "epci": {
                    "items": {
                      "properties": {
                        "code": {
                          "maxLength": 9,
                          "type": "string",
                        },
                      },
                      "required": [
                        "code",
                      ],
                      "type": "object",
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array",
                  },
                  "epciGroupId": {
                    "maxLength": 64,
                    "nullable": true,
                    "type": "string",
                  },
                  "epciGroupName": {
                    "maxLength": 255,
                    "nullable": true,
                    "type": "string",
                  },
                  "millesime": {
                    "maxLength": 10,
                    "type": "string",
                  },
                  "name": {
