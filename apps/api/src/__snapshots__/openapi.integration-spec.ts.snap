    "/api/projections/households": {
      "get": {
        "operationId": "ProjectionsController_getHouseholds",
        "parameters": [
          {
            "description": "Codes de zone séparés par des virgules. Les codes EPCI et bassin sont disjoints, le niveau est donc implicite.",
            "in": "query",
            "name": "zoneCodes",
            "required": true,
            "schema": {
              "description": "Codes de zone séparés par des virgules. Les codes EPCI et bassin sont disjoints, le niveau est donc implicite.",
              "items": {
                "type": "string",
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array",
            },
          },
