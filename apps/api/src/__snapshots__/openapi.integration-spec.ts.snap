                    "type": "array",
                  },
                  "prorataTotal": {
                    "type": "number",
                  },
                  "total": {
                    "type": "number",
                  },
                },
                "required": [
                  "epcis",
                  "total",
                  "prorataTotal",
                ],
                "type": "object",
              },
              "secondaryAccommodation": {
                "description": "Residences secondaires",
                "type": "number",
              },
              "total": {
                "description": "Total général (stock + flux)",
                "type": "number",
              },
              "totalFlux": {
                "description": "Total besoins flux (B2)",
                "type": "number",
              },
              "totalStock": {
                "description": "Total besoins stock (B1)",
                "type": "number",
              },
              "vacantAccomodation": {
                "description": "Logements vacants",
                "type": "number",
              },
            },
            "required": [
              "epcisTotals",
              "total",
              "totalFlux",
              "totalStock",
              "vacantAccomodation",
              "secondaryAccommodation",
              "noAccomodation",
              "hosted",
              "financialInadequation",
              "badQuality",
              "physicalInadequation",
            ],
            "type": "object",
          },
          "updatedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string",
          },
        },
        "required": [
          "id",
          "name",
          "createdAt",
          "updatedAt",
          "epcis",
          "results",
        ],
        "type": "object",
      },
      "UnauthorizedResponseDto": {
        "properties": {
          "message": {
            "type": "string",
          },
          "statusCode": {
            "type": "number",
          },
        },
        "required": [
          "statusCode",
          "message",
        ],
        "type": "object",
      },
      "UpdateScenarioDto": {
        "properties": {
          "b11_etablissement": {
            "items": {
              "enum": [
                "autreCentre",
                "demandeAsile",
                "reinsertion",
                "centreProvisoire",
                "jeuneTravailleur",
                "foyerMigrants",
                "malade",
                "maisonRelai",
                "horsMaisonRelai",
              ],
              "type": "string",
            },
            "type": "array",
          },
          "b11_fortune": {
            "type": "boolean",
          },
          "b11_hotel": {
            "type": "boolean",
          },
          "b11_part_etablissement": {
            "type": "number",
          },
          "b11_sa": {
            "type": "boolean",
          },
          "b12_cohab_interg_subie": {
            "type": "number",
          },
          "b12_heberg_particulier": {
            "type": "boolean",
          },
          "b12_heberg_temporaire": {
            "type": "boolean",
          },
          "b13_acc": {
            "type": "boolean",
          },
          "b13_plp": {
            "type": "boolean",
          },
          "b13_taux_effort": {
            "type": "number",
          },
          "b13_taux_reallocation": {
            "type": "number",
          },
          "b14_confort": {
            "type": "string",
          },
          "b14_occupation": {
            "type": "string",
          },
          "b14_qualite": {
            "type": "string",
          },
          "b14_taux_reallocation": {
            "type": "number",
          },
          "b15_loc_hors_hlm": {
            "type": "boolean",
          },
          "b15_proprietaire": {
            "type": "boolean",
          },
          "b15_surocc": {
            "enum": [
              "Acc",
              "Mod",
            ],
            "type": "string",
          },
          "b15_taux_reallocation": {
            "type": "number",
          },
          "b1_horizon_resorption": {
            "type": "number",
          },
          "b2_scenario": {
            "type": "string",
          },
          "epciScenarios": {
            "additionalProperties": {
              "properties": {
                "b2_tx_disparition": {
                  "type": "number",
                },
                "b2_tx_restructuration": {
                  "type": "number",
                },
                "b2_tx_rs": {
                  "type": "number",
                },
                "b2_tx_vacance": {
                  "type": "number",
                },
                "b2_tx_vacance_courte": {
                  "type": "number",
                },
                "b2_tx_vacance_longue": {
                  "type": "number",
                },
              },
              "type": "object",
            },
            "type": "object",
          },
          "millesime": {
            "type": "string",
          },
          "projection": {
            "type": "number",
          },
          "source_b11": {
            "enum": [
              "RP",
              "SNE",
            ],
            "type": "string",
          },
          "source_b14": {
            "anyOf": [
              {
                "enum": [
                  "RP",
                ],
                "type": "string",
              },
              {
                "enum": [
                  "Filo",
                ],
                "type": "string",
              },
              {
                "enum": [
                  "FF",
                ],
                "type": "string",
              },
            ],
          },
          "source_b15": {
            "anyOf": [
              {
                "enum": [
                  "RP",
                ],
                "type": "string",
              },
              {
                "enum": [
                  "Filo",
                ],
                "type": "string",
              },
            ],
          },
        },
        "type": "object",
      },
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "API Key au format otelo_xxx",
        "scheme": "bearer",
        "type": "http",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "API Otelo pour les consommateurs externes.

Authentification : \`Authorization: Bearer otelo_xxx\`

Contactez un administrateur pour obtenir une clé API par mail : otelo@beta.gouv.fr",
    "title": "Otelo - API externe",
    "version": "1.0",
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/external/simulations": {
      "get": {
        "description": "Retourne toutes les simulations créées par ce consommateur API, triées par date de modification.",
        "operationId": "ExternalController_listSimulations",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SimulationListItemDto",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Liste des simulations",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Lister les simulations du consommateur",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
      "post": {
        "description": "Crée un scénario, une simulation sur les EPCI sélectionnés, calcule les besoins en logements (stock B1 + flux B2) et retourne les résultats complets.",
        "operationId": "ExternalController_createSimulation",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSimulationDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationWithResultsDto",
                },
              },
            },
            "description": "Simulation créée avec résultats",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Créer une simulation et obtenir les résultats",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
    "/api/external/simulations/{simulationId}": {
      "delete": {
        "description": "Supprime (soft-delete) une simulation appartenant au consommateur.",
        "operationId": "ExternalController_deleteSimulation",
        "parameters": [
          {
            "description": "ID de la simulation",
            "in": "path",
            "name": "simulationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Simulation supprimée",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponseDto",
                },
              },
            },
            "description": "Simulation non trouvée",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Supprimer une simulation",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
    "/api/external/simulations/{simulationId}/results": {
      "get": {
        "description": "Calcule (ou recalcule) les besoins en logements et retourne les résultats complets.",
        "operationId": "ExternalController_getResults",
        "parameters": [
          {
            "description": "ID de la simulation",
            "in": "path",
            "name": "simulationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationWithResultsDto",
                },
              },
            },
            "description": "Résultats de la simulation",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponseDto",
                },
              },
            },
            "description": "Simulation non trouvée",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Obtenir les résultats d'une simulation",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
    "/api/external/simulations/{simulationId}/scenario": {
      "put": {
        "description": "Met à jour les paramètres du scénario (B1-B15, projection, etc.) et/ou les taux par EPCI (B2). Recalcule et retourne les résultats.",
        "operationId": "ExternalController_updateSimulation",
        "parameters": [
          {
            "description": "ID de la simulation",
            "in": "path",
            "name": "simulationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScenarioDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationWithResultsDto",
                },
              },
            },
            "description": "Résultats recalculés",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponseDto",
                },
              },
            },
            "description": "Simulation non trouvée",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Mettre à jour le paramétrage et recalculer les résultats",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
  },
  "servers": [],
  "tags": [],
}
`;
