    "/api/email/contact": {
      "post": {
        "operationId": "EmailController_contact",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 254,
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string",
                  },
                  "firstname": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string",
                  },
                  "lastname": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string",
                  },
                  "message": {
                    "maxLength": 5000,
                    "minLength": 1,
                    "type": "string",
                  },
                  "subject": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "firstname",
                  "lastname",
                  "email",
                  "subject",
                  "message",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "description": "",
          },
        },
        "tags": [
          "Email",
        ],
      },
    },
