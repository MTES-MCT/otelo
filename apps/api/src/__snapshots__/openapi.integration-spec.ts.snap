    "/api/export-powerpoint": {
      "post": {
        "operationId": "ExportPowerpointController_requestPowerpoint",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "documentType": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "epci": {
                    "properties": {
                      "code": {
                        "type": "string",
                      },
                      "name": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "code",
                      "name",
                    ],
                    "type": "object",
                  },
                  "epcis": {
                    "items": {
                      "properties": {
                        "code": {
                          "type": "string",
                        },
                        "name": {
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "code",
                        "name",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                  "nextStep": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "periodEnd": {
                    "pattern": "^\\d{4}$",
                    "type": "string",
                  },
                  "periodStart": {
                    "pattern": "^\\d{4}$",
                    "type": "string",
                  },
                  "privilegedSimulation": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "replacesRequestId": {
                    "type": "string",
                  },
                  "resultDate": {
                    "minLength": 1,
                    "type": "string",
                  },
                  "selectedSimulations": {
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 3,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "nextStep",
                  "resultDate",
                  "selectedSimulations",
                  "privilegedSimulation",
                  "documentType",
                  "periodStart",
                  "periodEnd",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "description": "",
          },
        },
        "tags": [
          "ExportPowerpoint",
        ],
      },
    },
    "/api/export-powerpoint/check": {
      "post": {
        "operationId": "ExportPowerpointController_checkDuplicate",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "epciCodes": {
                    "default": [],
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "selectedSimulations": {
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 3,
                    "minItems": 1,
                    "type": "array",
                  },
                },
                "required": [
                  "selectedSimulations",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "description": "",
          },
        },
        "tags": [
          "ExportPowerpoint",
        ],
      },
    },
    "/api/external/simulations": {
      "get": {
        "description": "Retourne toutes les simulations créées par ce consommateur API, triées par date de modification.",
        "operationId": "ExternalController_listSimulations",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SimulationListItemDto",
                  },
                  "type": "array",
                },
              },
            },
            "description": "Liste des simulations",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Lister les simulations du consommateur",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
      "post": {
        "description": "Crée un scénario, une simulation sur les EPCI sélectionnés, calcule les besoins en logements (stock B1 + flux B2) et retourne les résultats complets.",
        "operationId": "ExternalController_createSimulation",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSimulationDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationWithResultsDto",
                },
              },
            },
            "description": "Simulation créée avec résultats",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Créer une simulation et obtenir les résultats",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
    "/api/external/simulations/{simulationId}": {
      "delete": {
        "description": "Supprime (soft-delete) une simulation appartenant au consommateur.",
        "operationId": "ExternalController_deleteSimulation",
        "parameters": [
          {
            "description": "ID de la simulation",
            "in": "path",
            "name": "simulationId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
        ],
        "responses": {
          "204": {
            "description": "Simulation supprimée",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponseDto",
                },
              },
            },
            "description": "Clé API invalide ou inactive",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponseDto",
                },
              },
            },
            "description": "Simulation non trouvée",
          },
        },
        "security": [
          {
            "bearer": [],
          },
        ],
        "summary": "Supprimer une simulation",
        "tags": [
          "Simulations - Résultats méthodo Otelo",
        ],
      },
    },
    "/api/external/simulations/{simulationId}/results": {
      "get": {
        "description": "Calcule (ou recalcule) les besoins en logements et retourne les résultats complets.",
        "operationId": "ExternalController_getResults",
        "parameters": [
          {
            "description": "ID de la simulation",
            "in": "path",
            "name": "simulationId",
