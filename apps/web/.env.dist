NEXT_PUBLIC_AUTH_API_URL=https://otelo-dev.osc-fr1.scalingo.io/api
NEXT_PUBLIC_APP_URL=https://otelo-v4.osc-fr1.scalingo.io
NEXT_PUBLIC_DOCURBA_BASE_URL=https://docurba.beta.gouv.fr

# Mesure d'audience Matomo.
# Variables `NEXT_PUBLIC_*` : elles sont inlinées AU BUILD, elles doivent donc être
# définies au moment du `pnpm build:web` (et pas seulement au runtime).
# Laisser vide désactive proprement le tracker ; une valeur bidon ferait charger un
# script inexistant sur chaque page.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

BREVO_API_KEY=xxxx
BREVO_API_URL=https://api.brevo.com/v3/smtp/email