# Fond de plan CARTO. Sans clé, les tuiles sont servies tatouées « API KEY REQUIRED ».
# Comme les autres `NEXT_PUBLIC_*`, elle est inlinée au build : la poser sur la plateforme
# impose un redéploiement, un simple restart ne suffit pas.
NEXT_PUBLIC_CARTO_KEY=

BREVO_API_KEY=xxxx
BREVO_API_URL=https://api.brevo.com/v3/smtp/email